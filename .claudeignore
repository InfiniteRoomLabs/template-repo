__pycache__/
*.pyc
.pytest_cache/
node_modules/
dist/
build/
.venv/
venv/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Logs and databases
*.log
*.db
*.sqlite
