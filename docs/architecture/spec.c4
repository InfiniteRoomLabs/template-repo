// Element and relationship kinds for <project>.
// Every kind used in model.c4 must be declared here. Keep this file small and
// stable: a change here forces a full re-parse of the workspace.
specification {
  element actor {
    style {
      shape person
    }
  }
  element system
  element component
  element datastore {
    style {
      shape storage
    }
  }

  relationship uses
  relationship async {
    line dotted
  }

  tag external
  tag deprecated {
    color #9e9e9e
  }
}
